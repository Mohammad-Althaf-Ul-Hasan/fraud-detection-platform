# ---- Stage 1: dependencies ----
FROM python:3.11-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ---- Stage 2: runtime ----
FROM python:3.11-slim

# Non-root user
RUN useradd -m -u 1000 -s /bin/bash app
WORKDIR /app
RUN mkdir -p /app/data /app/data/processed /app/models && chown -R app:app /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy dependencies from builder
COPY --from=builder /root/.local /home/app/.local

# Copy application code
COPY --chown=app:app common/      ./common/
COPY --chown=app:app services/    ./services/
COPY --chown=app:app scripts/     ./scripts/
COPY --chown=app:app feature_repo/ ./feature_repo/
COPY --chown=app:app .env.example ./

USER app
ENV PATH=/home/app/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "services.scoring_service:app", "--host", "0.0.0.0", "--port", "8000"]