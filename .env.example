# Fraud Detection Platform — environment configuration
# Copy to .env and edit for your environment. All vars are optional;
# defaults match the local-development setup.

# Kafka
KAFKA_BROKER=localhost:9092

# Redis (state, cache, GNN embeddings)
REDIS_HOST=localhost
REDIS_PORT=6379

# MLflow tracking (leave empty to use local sqlite:///mlflow.db)
# MLFLOW_TRACKING_URI=http://mlflow.internal:5000

# API keys (P2 — auth on write endpoints; empty = no auth, dev only)
# API_KEYS=dev-key-1,dev-key-2

# P2: API key auth (empty = dev mode, auth disabled)
# Comma-separated list. e.g. "analyst-key-abc,service-key-xyz"
API_KEYS=

# P2: Rate limiting (per-API-key sliding window)
# 0 = unlimited. Default 10 req/s with 50-event burst.
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_BURST=50

# Frontend (build-time)
VITE_API_BASE=http://127.0.0.1:8000

# LLM narrative provider (optional — plain-English case narratives)
# One of: anthropic | openai | ollama | deferred
# If left empty, auto-detects from the API keys below.
LLM_PROVIDER=

# Anthropic Claude (recommended — Haiku 3.5, ~$0.001 per narrative)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o-mini, similar cost)
OPENAI_API_KEY=

# Ollama (free, local — install from https://ollama.com, run: ollama pull llama3.2:3b)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# Safety cap on narrative calls per container lifetime (default 500)
MAX_NARRATIVES_PER_DAY=500